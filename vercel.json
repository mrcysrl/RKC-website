{
  "rewrites": [
    {
      "source": "/wp-json/(.*)",
      "destination": "https://cms.rkcindustrialph.com/wp-json/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/wp-json/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}