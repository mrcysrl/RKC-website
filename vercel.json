{
  "rewrites": [
    {
      "source": "/wp-json/(.*)",
      "destination": "https://www.rkcindustrialph.com/wp-json/$1"
    },
    {
      "source": "/wp-content/uploads/(.*)",
      "destination": "https://www.rkcindustrialph.com/wp-content/uploads/$1"
    },
    {
      "source": "/wp-admin/(.*)",
      "destination": "https://www.rkcindustrialph.com/wp-admin/$1"
    },
    {
      "source": "/wp-login.php",
      "destination": "https://www.rkcindustrialph.com/wp-login.php"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}