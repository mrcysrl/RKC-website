{
  "rewrites": [
    {
      "source": "/wp-json/(.*)",
      "destination": "https://cms.rkcindustrialph.com/wp-json/$1"
    },
    {
      "source": "/wp-content/uploads/(.*)",
      "destination": "https://cms.rkcindustrialph.com/wp-content/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}